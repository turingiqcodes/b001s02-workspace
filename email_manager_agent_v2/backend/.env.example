# Copy to backend/.env and fill in. Never commit .env.

# --- Groq (AI model) ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# low | medium | high (reasoning models); leave empty for models without reasoning, e.g. llama-3.3-70b-versatile
GROQ_REASONING_EFFORT=medium
GROQ_MAX_TOKENS=8192

# --- Google Apps Script bridge ---
# Web app URL from Deploy > Manage deployments (ends in /exec)
APPS_SCRIPT_URL=
# Must equal the BRIDGE_SECRET script property (at least 16 characters)
APPS_SCRIPT_SECRET=
BRIDGE_TIMEOUT_SECONDS=90

# --- Agent ---
AGENT_MAX_STEPS=15
# How much email text is sent to the AI (characters). SRS maximums: 6000 / 3000 / 60000.
# Kept small so requests fit Groq's free-tier limit (8000 tokens/minute). Raise on a paid tier.
EMAIL_BODY_LIMIT=2500
LIST_BODY_LIMIT=300
TOOL_RESULT_LIMIT=8000
HISTORY_CHAR_BUDGET=10000

# --- Server ---
# HOST=127.0.0.1
# PORT=8000
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
