{
  "description": "PR review guardrails: read-only while reviewing, confirm before publishing, validate reports, don't stop mid-review.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/review_guard.py\"", "timeout": 10 }
        ]
      },
      {
        "matcher": "Bash|mcp__github__create_pull_request_review|mcp__github__add_issue_comment|mcp__github__update_pull_request|mcp__github__merge_pull_request",
        "hooks": [
          { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/confirm_publish.py\"", "timeout": 10 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/validate_report.py\"", "timeout": 10 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/review_complete_check.py\"", "timeout": 10 }
        ]
      }
    ]
  }
}
