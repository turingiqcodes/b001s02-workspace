# Copy to .env and fill in. .env is git-ignored; never commit real credentials.
BOOKNEST_DB_HOST=your-rds-endpoint.rds.amazonaws.com
BOOKNEST_DB_PORT=5432
BOOKNEST_DB_NAME=pubs
BOOKNEST_DB_USER=booknest_app
BOOKNEST_DB_PASSWORD=
BOOKNEST_DB_SSLMODE=require
# Stronger: also check the server's certificate. Download the RDS CA bundle from
# https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem, then:
# BOOKNEST_DB_SSLMODE=verify-full
# BOOKNEST_DB_SSLROOTCERT=/path/to/global-bundle.pem
# API key lifetime in hours (normal login / "Remember me")
BOOKNEST_KEY_HOURS=8
BOOKNEST_KEY_HOURS_REMEMBER=720
