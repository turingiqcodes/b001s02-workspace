# Copy to .env (in this folder) and fill in. Never commit the real .env.
# List values use JSON, for example WORK_DAYS=[0,1,2,3,4].

# --- Language model -----------------------------------------------------------
# "ollama" (default, runs on this computer) or "claude" (Anthropic API)
LLM_PROVIDER=ollama

# Ollama: the model you pulled with `ollama pull`. There is no built-in default.
OLLAMA_MODEL=qwen3:8b
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Context window in tokens. Ollama's own default is too small for this app.
OLLAMA_NUM_CTX=16384
# Raise on slow (CPU-only) machines.
OLLAMA_TIMEOUT_SECONDS=600
# How long the model stays loaded between requests.
OLLAMA_KEEP_ALIVE=30m
# For thinking models such as qwen3: false is faster. Leave unset for other models.
# OLLAMA_THINK=false

# Claude (only when LLM_PROVIDER=claude). Key from https://console.anthropic.com
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# Reasoning effort: low | medium | high | xhigh | max
CLAUDE_EFFORT=medium
# Server-side fallback when Claude declines a request
CLAUDE_REFUSAL_FALLBACK=true

# --- Google Apps Script bridge -------------------------------------------------
# Web App URL ending in /exec (see docs/APPS_SCRIPT_SETUP.md)
APPS_SCRIPT_URL=https://script.google.com/macros/s/XXXXXXXX/exec
# Random secret (at least 16 characters). Set the same value as the
# BRIDGE_SHARED_SECRET script property. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
APPS_SCRIPT_SHARED_SECRET=
BRIDGE_TIMEOUT_SECONDS=30

# --- You ---------------------------------------------------------------------
# IANA timezone, used for working hours and times without an offset
USER_TIMEZONE=UTC
# Working days (Monday=0 ... Sunday=6) and hours, used for free slots and warnings
WORK_DAYS=[0,1,2,3,4]
WORK_START=09:00
WORK_END=18:00

# --- Limits (assumed values; see docs/REQUIREMENTS_CHECKLIST.md) ----------------
MAX_AGENT_STEPS=8
MAX_PROMPT_CHARS=4000
MAX_SEARCH_RESULTS=25
MAX_EMAIL_BODY_CHARS=20000
MAX_ATTACHMENT_MB=20
MAX_RECIPIENTS=20
APPROVAL_TTL_SECONDS=600
SESSION_TTL_SECONDS=7200
MAX_SESSIONS=50

# --- Server ------------------------------------------------------------------
# Must be a loopback address; run.py refuses anything else.
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173
LOG_LEVEL=INFO
