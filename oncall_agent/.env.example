# Agent
ONCALL_POLL_INTERVAL_SECONDS=60
ONCALL_MAX_AUTO_RETRIES=2
ONCALL_MAX_RETRIES_PER_HOUR=10
ONCALL_RETRY_TIMEOUT_MINUTES=30
# Extra (justified in README): detection overlap window and first-run lookback
ONCALL_DETECTION_OVERLAP_MINUTES=10
ONCALL_INITIAL_LOOKBACK_HOURS=24
# Only DAGs listed in config/dag_repos.json are monitored. Set true to monitor every DAG
# (do NOT do this on a shared Airflow: it would touch other people's DAGs).
ONCALL_MONITOR_ALL_DAGS=false
# Force every integration to its offline mock (useful for demos)
ONCALL_FORCE_MOCKS=false

# LLM provider for failure analysis: groq (default) or claude
ONCALL_LLM_PROVIDER=groq

# Groq (default). Without GROQ_API_KEY the rule-based analyzer is used.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# low | medium | high for reasoning models (gpt-oss); leave empty for non-reasoning models (e.g. llama)
GROQ_REASONING_EFFORT=medium

# Claude (optional, only used when ONCALL_LLM_PROVIDER=claude; needs: pip install -e ".[claude]")
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Airflow
AIRFLOW_BASE_URL=http://localhost:18080
AIRFLOW_USERNAME=
AIRFLOW_PASSWORD=

# GitHub
GITHUB_TOKEN=

# Linear
LINEAR_API_KEY=
LINEAR_TEAM_ID=

# MCP
ONCALL_MCP_ALLOW_AIRFLOW_WRITES=false

# Storage
ONCALL_DATABASE_PATH=./data/oncall_agent.db

# Config files
ONCALL_DAG_REPOS_PATH=./config/dag_repos.json
ONCALL_OWNERS_PATH=./config/owners.json
