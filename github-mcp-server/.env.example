# Copy to .env and fill in. .env is git-ignored; never commit a real token.
# Real environment variables override values in this file.

# --- GitHub token -----------------------------------------------------------
# Fine-grained personal access token (starts with github_pat_).
# Create at: GitHub -> Settings -> Developer settings -> Fine-grained tokens
#   Resource owner:      the user/org that owns the repos (one owner per token)
#   Repository access:   "All repositories" (needed for create_repository) or selected repos
#   Repository permissions used by the toolsets:
#     Metadata ........ Read (always on)
#     Administration .. Read and write  -> create_repository
#     Contents ........ Read and write  -> files, branches, commits, merge PR
#     Pull requests ... Read and write  -> pull request tools
#     Issues .......... Read and write  -> issue tools
#     Actions ......... Read and write  -> workflow runs, logs, trigger/rerun/cancel
#     Workflows ....... Read and write  -> only to edit .github/workflows/* files
GITHUB_PERSONAL_ACCESS_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxxxx

# --- Optional ---------------------------------------------------------------
# GitHub Enterprise Server API root
# GITHUB_API_URL=https://ghe.example.com/api/v3

# Comma-separated toolsets: repos,pulls,actions,issues,search (default: all)
# GITHUB_TOOLSETS=repos,pulls,actions,issues,search

# true = register only read-only tools
GITHUB_READ_ONLY=false
