# Copy to backend/.env and fill in. Never commit the real .env.

# Anthropic API key (https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# Model and reasoning effort (low | medium | high | xhigh | max)
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium

# Server-side refusal fallback (re-runs a declined request on Anthropic's recommended model)
CLAUDE_ENABLE_FALLBACKS=true

# "apps_script" talks to your deployed Google Apps Script web app.
# "mock" uses built-in fake Gmail/Calendar/Drive data (no Google account needed).
BRIDGE_MODE=mock

# Apps Script web app URL (Deploy > New deployment > Web app) and the shared secret.
# The same secret must be stored as the BRIDGE_TOKEN Script Property in Apps Script.
APPS_SCRIPT_URL=https://script.google.com/macros/s/XXXXXXXX/exec
BRIDGE_TOKEN=change-me-to-a-long-random-string

# Fallback timezone if the bridge can't report one
USER_TIMEZONE=UTC

# Comma-separated allowed browser origins
CORS_ORIGINS=http://localhost:5173
